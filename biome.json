{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.mts",
      ".apm/skills/manga-rss-bridge/scripts/*.mts",
      ".agents/skills/manga-rss-bridge/scripts/*.mts",
      "*.json",
      "*.md",
      "*.yaml",
      "*.yml",
      "!dist",
      "!node_modules"
    ]
  }
}
