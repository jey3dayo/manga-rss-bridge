{
  "name": "manga-rss-bridge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Self-hosted RSS bridge for manga chapter feeds.",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mts",
    "format": "pnpm exec biome format --write .",
    "format:check": "pnpm exec biome format .",
    "format:md": "pnpm exec markdownlint-cli2 --fix",
    "lint": "pnpm exec biome lint .",
    "lint:fix": "pnpm exec biome lint --write .",
    "lint:md": "pnpm exec markdownlint-cli2",
    "check": "pnpm exec tsc -p tsconfig.check.json",
    "test": "pnpm exec vitest run src scripts",
    "test:opml": "pnpm exec vitest run tests/generate_freshrss_opml.test.ts",
    "test:watch": "pnpm exec vitest src scripts"
  },
  "keywords": [
    "rss",
    "manga",
    "comic",
    "bridge",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@praha/byethrow": "^0.13.0",
    "hono": "4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
